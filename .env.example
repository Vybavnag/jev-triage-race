# ── Required ────────────────────────────────────────────────────────────────
# Jev (TypeSafe AI) — get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# ── Opponent: pick at least one ─────────────────────────────────────────────
# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, ...). All server-side;
# the browser can never set these.
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4o-mini
# Prices in USD per million tokens, used for the cost counter. If unset the UI
# shows cost as "unknown" for this provider.
# OPENAI_COMPAT_PRICE_IN=
# OPENAI_COMPAT_PRICE_OUT=

# ── Guardrails (optional, recommended when internet-exposed) ────────────────
# Set a token to gate race starts/cancels (Authorization: Bearer <token>).
# When set, the public rate-limit bucket is disabled — the token is the gate.
# RACE_TOKEN=

# Max tickets per race (hard server-side cap; default 25, ceiling = dataset size)
# RACE_MAX_ITEMS=25

# Per-side concurrency
# JEV_CONCURRENCY=8
# LLM_CONCURRENCY=4

# Honor X-Forwarded-For for rate limiting (only behind a trusted proxy)
# TRUST_PROXY=false

# Set to "prod" to disable /docs and /openapi.json
# ENV=dev
