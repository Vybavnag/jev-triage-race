# Everything here is optional. Provider keys are NOT set here: the page asks
# each visitor for their own TypeSafe and Anthropic keys, and the server keeps
# nothing. Copy this file to .env only if you want to change a setting.

# ── Opponent: an OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, ...) ─────
# Operator-only, because it carries a base URL the server will connect to.
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4o-mini
# Prices in USD per million tokens, used for the cost counter. If unset the UI
# shows cost as "unknown" for this provider.
# OPENAI_COMPAT_PRICE_IN=
# OPENAI_COMPAT_PRICE_OUT=

# ── Rate limiting (public mode) ──────────────────────────────────────────────
# Visitors spend their own keys, so these bound this server's compute. See the
# "Rate limiting" section of the README for where they live in the code.
# RATE_LIMITING=true          # false switches every per-IP limit off (local clone)
# RACE_BURST=3                # races an IP may start at once ...
# RACE_PER_MINUTE=1           # ... then how many per minute
# REVIEW_BURST=5
# REVIEW_PER_MINUTE=2
# REVIEW_IN_FLIGHT=2          # reviews the whole process runs at once (even with a token)

# ── Guardrails ───────────────────────────────────────────────────────────────
# Gate race starts, cancels and reviews behind a bearer token
# (Authorization: Bearer <token>). Holders skip the per-IP limits.
# RACE_TOKEN=

# Max tickets per race, bundled or pasted (default 25)
# RACE_MAX_ITEMS=25

# Per-side concurrency within a race
# JEV_CONCURRENCY=8
# LLM_CONCURRENCY=4

# Code review timeouts in seconds: per attempt, then the outer bound per side
# REVIEW_ATTEMPT_TIMEOUT=25
# REVIEW_TIMEOUT=60

# Honor X-Forwarded-For for rate limiting (only behind a trusted proxy)
# TRUST_PROXY=false

# Set to "prod" to disable /docs and /openapi.json
# ENV=dev
